new file mode 100644
index 0000000..8bc57f0
--- /dev/null
+++ b/tests/test_vllm_dp_context.py
@@ -0,0 +1,56 @@
+"""Exercise the actual normalization method without loading torch or a model."""
+import ast
+import copy
+import logging
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+
+
+class VLLM:
+    max_length = 4096
+    tokenizer = SimpleNamespace(encode=lambda prompt: list(range(len(prompt))))
+
+
+class HF:
+    model = SimpleNamespace(config=SimpleNamespace(max_position_embeddings=4096))
+    tokenizer = VLLM.tokenizer
+
+
+class OpenAI:
+    pass
+
+
+class NormalizationTest(unittest.TestCase):
+    def test_dp_context_matches_hf_and_keeps_task_settings(self):
+        source = Path(__file__).parents[1] / "eval/task.py"
+        tree = ast.parse(source.read_text())
+        cls = next(n for n in tree.body if isinstance(n, ast.ClassDef) and n.name == "BaseBenchmark")
+        method = next(n for n in cls.body if isinstance(n, ast.FunctionDef) and n.name == "_normalize_model_args")
+        method.returns = None
+        for arg in method.args.args:
+            arg.annotation = None
+        noop = SimpleNamespace(seed=lambda value: None, manual_seed=lambda value: None)
+        space = dict(random=noop, np=SimpleNamespace(random=noop), torch=noop,
+                     SAFETY_BUFFER_TOKENS=16, lm_eval_models=SimpleNamespace(
+                         vllm_causallms=SimpleNamespace(VLLM=VLLM),
+                         huggingface=SimpleNamespace(HFLM=HF),
+                         openai_completions=SimpleNamespace(OpenAIChatCompletion=OpenAI, OpenAICompletionsAPI=OpenAI)))
+        exec(compile(ast.Module(body=[method], type_ignores=[]), str(source), "exec"), space)
+        normalize = space["_normalize_model_args"]
+        for prompt_len in (10, 100, 4079, 4096):
+            for max_tokens in (2048, 32768):
+                args = {"max_new_tokens": max_tokens, "do_sample": False, "temperature": 0.7, "seed": [0, 1234, 1234, 1234]}
+                results = []
+                for model in (HF(), VLLM(), VLLM()):
+                    instance = SimpleNamespace(args=("x" * prompt_len, copy.deepcopy(args)))
+                    normalize(SimpleNamespace(logger=logging.getLogger(__name__)), model, [instance])
+                    values = instance.args[1]
+                    results.append(values.get("max_gen_toks", values.get("max_new_tokens")))
+                    self.assertFalse(values["do_sample"])
+                    self.assertEqual(values["temperature"], 0.7)
+                self.assertEqual(results, [min(max_tokens, max(1, 4096-prompt_len-16))] * 3)
+
+
+if __name__ == "__main__":
+    unittest.main()
