diff --git a/lm_eval/models/vllm_single_token.py b/lm_eval/models/vllm_single_token.py
new file mode 100644
--- /dev/null
+++ b/lm_eval/models/vllm_single_token.py
@@ -0,0 +1,56 @@
+"""Share single-token likelihood contexts without restricting the vocabulary.
+
+Dependency-free planning/reassembly for the lm-eval vLLM adapter. Multi-token
+requests retain their original prompt-logprob route and truncation semantics.
+"""
+from dataclasses import dataclass, field
+
+
+@dataclass
+class ScoringRequest:
+    tokens: list[int]
+    selected: list[int] | None
+    members: list[tuple[int, int]] = field(default_factory=list)
+
+
+def plan_requests(inputs, ctxlens, enabled=True, max_selected=128):
+    if len(inputs) != len(ctxlens):
+        raise ValueError("Input/context length count differs")
+    plans = []
+    groups = {}
+    for index, (tokens, ctxlen) in enumerate(zip(inputs, ctxlens, strict=True)):
+        # Inputs are already truncated by the adapter, including the target.
+        if enabled and ctxlen > 0 and len(tokens) == ctxlen + 1:
+            context, target = tuple(tokens[:-1]), tokens[-1]
+            group = groups.get(context)
+            if group is None or (target not in group.selected and len(group.selected) >= max_selected):
+                group = ScoringRequest(list(context), [])
+                groups[context] = group
+                plans.append(group)
+            if target not in group.selected:
+                group.selected.append(target)
+            group.members.append((index, ctxlen))
+        else:
+            plans.append(ScoringRequest(tokens, None, [(index, ctxlen)]))
+    return plans
+
+
+def restore_answers(plans, outputs, inputs, parse_prompt):
+    answers = [None] * len(inputs)
+    for plan, output in zip(plans, outputs, strict=True):
+        if plan.selected is None:
+            index, ctxlen = plan.members[0]
+            answers[index] = parse_prompt(tokens=plan.tokens, outputs=output, ctxlen=ctxlen)
+            continue
+        generated = output.outputs[0]
+        probabilities = generated.logprobs[0]
+        greedy_token = generated.token_ids[0]
+        for index, _ in plan.members:
+            token = inputs[index][-1]
+            if token not in probabilities:
+                raise ValueError(f"vLLM omitted requested token logprob: {token}")
+            value = probabilities[token]
+            answers[index] = (float(getattr(value, "logprob", value)), token == greedy_token)
+    if any(answer is None for answer in answers):
+        raise ValueError("Incomplete likelihood result mapping")
+    return answers
