# INCLUDE (CohereForAI/include-base-44), 5-shot for FLAG tier 2. lm-eval's own few_shot_* variants
# set no fewshot_split, so their examples are random test items. Here the examples are the first five
# validation items (15-40 per language, Basque exactly 5), fixed across checkpoints; for every language
# but Estonian none of them is also a test item (checked 2026-11-18; Estonian: see utils.py). The
# whole test split is scored. Prompt as lm-eval's include default and our Global-MMLU.
dataset_path: CohereForAI/include-base-44
test_split: test
fewshot_split: validation
fewshot_config:
  sampler: first_n
num_fewshot: 5
output_type: multiple_choice
doc_to_text: "{{question.strip()}}\nA. {{option_a}}\nB. {{option_b}}\nC. {{option_c}}\nD. {{option_d}}\nAnswer:"
doc_to_choice: ["A", "B", "C", "D"]
doc_to_target: answer
metric_list:
  - metric: acc
    aggregation: mean
    higher_is_better: true
  - metric: acc_norm
    aggregation: mean
    higher_is_better: true
metadata:
  version: 1.0
