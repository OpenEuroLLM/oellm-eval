tag:
  - xcsqa
dataset_path: INK-USC/xcsr
output_type: multiple_choice
test_split: validation    # test split lacks answerKey values
fewshot_split: validation
doc_to_text: "Question: {{ question.stem.strip() }}\nA. {{question.choices.text[0]}}\nB. {{question.choices.text[1]}}\nC. {{question.choices.text[2]}}\nD. {{question.choices.text[3]}}\nE. {{question.choices.text[4]}}\nAnswer:"
doc_to_target: answerKey
doc_to_choice: ['A', 'B', 'C', 'D', 'E']
should_decontaminate: true
doc_to_decontamination_query: "Question: {{question.stem}}\nAnswer:"
metric_list:
  - metric: acc
    aggregation: mean
    higher_is_better: true
metadata:
  version: 1.0
dataset_kwargs:
  trust_remote_code: true
