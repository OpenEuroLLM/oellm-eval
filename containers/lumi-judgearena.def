Bootstrap: docker
From: vllm/vllm-openai-rocm:v0.19.1@sha256:c3457ab4702a5bd665b06d7ba57e6105fe98adc4f5b3d4afcf98ec45551988e0

%arguments
    JUDGEARENA_GIT_REF=main

%labels
    Author         OpenEuroLLM
    Description    JudgeArena with ROCm vLLM for LUMI
    JudgeArenaRef  {{ JUDGEARENA_GIT_REF }}

%post
    uv pip install --system --no-cache \
        "judgearena @ git+https://github.com/OpenEuroLLM/JudgeArena.git@{{ JUDGEARENA_GIT_REF }}"

%test
    python -c 'import judgearena, vllm; assert vllm.__version__ == "0.19.1"'
    judgearena tasks list >/dev/null

%environment
    export PYTHONNOUSERSITE=1

%runscript
    exec bash "$@"
