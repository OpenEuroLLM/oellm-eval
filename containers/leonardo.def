Bootstrap: docker
From: nvcr.io/nvidia/pytorch:25.10-py3

%arguments
    JUDGEARENA_GIT_REF=29f3091f16ca5df7ea287748528aecbaad29b620

%labels
    Author      oellm-cli
    Description Apptainer image for Leonardo cluster
    JudgeArenaRef {{ JUDGEARENA_GIT_REF }}

%post
    # Install uv
    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh
    export UV_TOOL_BIN_DIR=/usr/local/bin
    export UV_TOOL_DIR=/opt/uv-tools

    # lm-eval and dependencies (system Python)
    uv pip install --system --break-system-packages \
        lm-eval \
        transformers \
        "datasets<4.0.0" \
        wandb \
        sentencepiece \
        tiktoken \
        accelerate \
        nltk

    # JudgeArena needs a separate CUDA 13 PyTorch/VLLM runtime.
    uv venv --python 3.12 /opt/judgearena
    uv pip install --python /opt/judgearena/bin/python \
        --torch-backend cu130 \
        "torch==2.10.0" \
        "vllm @ https://github.com/vllm-project/vllm/releases/download/v0.19.1/vllm-0.19.1+cu130-cp38-abi3-manylinux_2_35_x86_64.whl" \
        "transformers==5.5.4" \
        "huggingface-hub>=1.5,<2" \
        "datasets>=4" \
        "judgearena @ git+https://github.com/OpenEuroLLM/JudgeArena.git@{{ JUDGEARENA_GIT_REF }}"
    ln -s /opt/judgearena/bin/judgearena /usr/local/bin/judgearena

    # lighteval as isolated tool (avoids dependency conflicts)
    uv tool install --python 3.12 \
        --with "langcodes[data]" \
        --with "pillow" \
        "lighteval[multilingual] @ git+https://github.com/huggingface/lighteval.git"

    # Pre-load lighteval registry to trigger tinyBenchmarks data download at build time
    /opt/uv-tools/lighteval/bin/python -c "from lighteval.tasks.registry import Registry; Registry.load_all_task_configs(load_multilingual=True)"

    # NLTK data
    mkdir -p /opt/nltk_data
    python -c "import nltk; nltk.download('punkt', download_dir='/opt/nltk_data'); nltk.download('punkt_tab', download_dir='/opt/nltk_data')"

%environment
    export PATH=/usr/local/bin:$PATH
    export UV_TOOL_BIN_DIR=/usr/local/bin
    export UV_TOOL_DIR=/opt/uv-tools
    export NLTK_DATA=/opt/nltk_data

%runscript
    exec bash "$@"
